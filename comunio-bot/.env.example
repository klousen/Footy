COMUNIO_COMMUNITY_ID=
COMUNIO_USER_ID=
# COMUNIO_BASE_URL=https://api.comunio.de

# --- ntfy ---
NTFY_TOPIC=            # langer, zufälliger Name, z. B. comunio-klaus-8f3k2x9q
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=          # nur bei geschütztem Thema / eigenem Server

# --- App ---
APP_URL=https://dein-projekt.vercel.app
SIGNING_SECRET=        # zufällig, z. B. `openssl rand -hex 32`
DASHBOARD_PASSWORD=
CRON_SECRET=           # zufällig, Vercel schickt ihn beim Cron-Aufruf mit

# --- Redis (setzt Vercel automatisch, wenn du Upstash über den Marketplace verbindest) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Strategie (alles optional, Standardwerte in lib/config.ts) ---
